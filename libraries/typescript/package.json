{
  "name": "world-fuel-prices",
  "version": "1.0.0",
  "description": "Tiny TypeScript/JavaScript client for the daily-refreshed world fuel prices open data API.",
  "keywords": [
    "fuel-prices",
    "gasoline",
    "diesel",
    "lpg",
    "open-data",
    "world",
    "choropleth"
  ],
  "license": "MIT",
  "author": "aykutsp",
  "homepage": "https://aykutsp.github.io/world-fuel-prices/",
  "repository": {
    "type": "git",
    "url": "https://github.com/aykutsp/world-fuel-prices.git",
    "directory": "libraries/typescript"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
